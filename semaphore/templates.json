{
  "defaults": {
    "inventory": "main",
    "repository": "ansible",
    "environment": "empty",
    "app": "ansible",
    "view": null
  },
  "templates": [
    {
      "name": "ping",
      "view": "Base",
      "description": "Проверка связи (playbooks/ping.yml)",
      "playbook": "playbooks/ping.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "all по умолчанию, группа (prod/stage) или хост", "default_value": "all", "type": "", "required": false}
      ]
    },
    {
      "name": "update",
      "view": "Base",
      "description": "apt update + upgrade, опционально reboot (playbooks/update.yml)",
      "playbook": "playbooks/update.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "all по умолчанию, группа (prod/stage) или хост", "default_value": "all", "type": "", "required": false},
        {"name": "apt_upgrade", "title": "apt_upgrade", "description": "dist или safe", "default_value": "dist", "type": "enum", "required": false, "values": [{"name": "dist", "value": "dist"}, {"name": "safe", "value": "safe"}]},
        {"name": "apt_autoremove", "title": "apt_autoremove", "description": "true — удалять осиротевшие пакеты", "default_value": "true", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]},
        {"name": "apt_autoclean", "title": "apt_autoclean", "description": "true — чистить кеш apt", "default_value": "true", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]},
        {"name": "reboot_if_required", "title": "reboot_if_required", "description": "true для авторебута", "default_value": "false", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]}
      ]
    },
    {
      "name": "base",
      "view": "Base",
      "description": "timezone + base packages (playbooks/base.yml)",
      "playbook": "playbooks/base.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "all по умолчанию, группа (prod/stage) или хост", "default_value": "all", "type": "", "required": false},
        {"name": "base_timezone", "title": "base_timezone", "description": "Например Etc/UTC или Europe/Berlin", "default_value": "Etc/UTC", "type": "", "required": false},
        {"name": "base_packages", "title": "base_packages", "description": "Text: один пакет на строку или через запятую. Например: curl, htop", "default_value": "python3, sudo, curl, htop", "type": "text", "required": false}
      ]
    },
    {
      "name": "run_script",
      "view": "Ad-hoc",
      "description": "Запуск скриптов из scripts/ (playbooks/run_script.yml)",
      "playbook": "playbooks/run_script.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "all по умолчанию, группа (prod/stage) или хост", "default_value": "all", "type": "", "required": false},
        {"name": "script_src", "title": "script_src", "description": "Обязательно, путь от корня репо, например scripts/hello.sh", "type": "", "required": true},
        {"name": "script_args", "title": "script_args", "description": "Аргументы скрипта, например --foo bar", "type": "", "required": false},
        {"name": "script_env", "title": "script_env", "description": "Text с JSON-объектом, например {\"FOO\": \"1\"}", "type": "text", "required": false},
        {"name": "script_become", "title": "script_become", "description": "false чтобы запустить без sudo", "default_value": "true", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]}
      ]
    },
    {
      "name": "run_cmd",
      "view": "Ad-hoc",
      "description": "Произвольная команда (playbooks/run_cmd.yml)",
      "playbook": "playbooks/run_cmd.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "all по умолчанию, группа (prod/stage) или хост", "default_value": "all", "type": "", "required": false},
        {"name": "cmd", "title": "cmd", "description": "Обязательно, например df -h", "type": "", "required": true},
        {"name": "use_shell", "title": "use_shell", "description": "false для строгого command без shell", "default_value": "true", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]},
        {"name": "cmd_chdir", "title": "cmd_chdir", "description": "Рабочая папка, опционально (например /opt)", "type": "", "required": false},
        {"name": "cmd_env", "title": "cmd_env", "description": "Text с JSON-объектом, например {\"FOO\": \"1\"}", "type": "text", "required": false},
        {"name": "cmd_become", "title": "cmd_become", "description": "false чтобы запустить без sudo", "default_value": "true", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]},
        {"name": "cmd_tail", "title": "cmd_tail", "description": "Показать только последние N строк (например 20; 0 — всё)", "default_value": "0", "type": "int", "required": false},
        {"name": "allow_fail", "title": "allow_fail", "description": "true чтобы не фейлить хост при rc != 0", "default_value": "false", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]}
      ]
    },
    {
      "name": "reboot",
      "view": "Base",
      "description": "Перезагрузка хостов, без подтверждения (playbooks/reboot.yml)",
      "playbook": "playbooks/reboot.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "Группа или хост (например prod). Аккуратнее с all", "type": "", "required": false},
        {"name": "reboot_msg", "title": "reboot_msg", "description": "Сообщение в wall перед ребутом (по умолчанию Reboot via Semaphore)", "default_value": "Reboot via Semaphore", "type": "", "required": false},
        {"name": "reboot_timeout", "title": "reboot_timeout", "description": "Секунд ждать возвращения хоста (по умолчанию 600)", "default_value": "600", "type": "int", "required": false},
        {"name": "reboot_connect_timeout", "title": "reboot_connect_timeout", "description": "Таймаут SSH-подключения после ребута (по умолчанию 30)", "default_value": "30", "type": "int", "required": false},
        {"name": "reboot_pre_delay", "title": "reboot_pre_delay", "description": "Пауза перед ребутом (по умолчанию 5)", "default_value": "5", "type": "int", "required": false},
        {"name": "reboot_post_delay", "title": "reboot_post_delay", "description": "Пауза после ребута перед проверкой (по умолчанию 15)", "default_value": "15", "type": "int", "required": false}
      ]
    },
    {
      "name": "init",
      "view": "Onboarding",
      "description": "Инит новой ноды: ключи + sshd. Первый прогон строго с Limit на одну тестовую ноду (playbooks/init.yml)",
      "playbook": "playbooks/init.yml",
      "survey_vars": [
        {"name": "target", "title": "Target", "description": "Имя новой ноды, например new-node-01. Не запускать на all", "type": "", "required": false},
        {"name": "ssh_user", "title": "ssh_user", "description": "Юзер должен существовать, обычно root", "default_value": "root", "type": "", "required": false},
        {"name": "ssh_keys", "title": "ssh_keys", "description": "Обязательно. Text: один публичник на строку или через запятую", "type": "text", "required": true},
        {"name": "skip_sshd", "title": "skip_sshd", "description": "true чтобы добавить только ключи без правок sshd (bootstrap по паролю)", "default_value": "false", "type": "enum", "required": false, "values": [{"name": "true", "value": "true"}, {"name": "false", "value": "false"}]},
        {"name": "sshd_permit_root_login", "title": "sshd_permit_root_login", "description": "prohibit-password по умолчанию", "default_value": "prohibit-password", "type": "", "required": false},
        {"name": "sshd_pubkey_auth", "title": "sshd_pubkey_auth", "description": "yes — разрешить вход по ключам", "default_value": "yes", "type": "", "required": false},
        {"name": "sshd_password_auth", "title": "sshd_password_auth", "description": "no — запретить вход по паролю", "default_value": "no", "type": "", "required": false},
        {"name": "sshd_permit_empty", "title": "sshd_permit_empty", "description": "no — запретить пустые пароли", "default_value": "no", "type": "", "required": false}
      ]
    },
    {
      "name": "00-bootstrap",
      "view": "Service",
      "app": "python",
      "description": "Сидинг шаблонов из semaphore/templates.json (этот репо)",
      "playbook": "scripts/semaphore_bootstrap.py",
      "survey_vars": [
        {"name": "token", "title": "API Token", "type": "secret", "required": true},
        {"name": "project_id", "title": "Project ID", "type": "", "required": true}
      ]
    }
  ]
}
