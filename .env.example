# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
#
# Генерация ключа шифрования:
#   head -c32 /dev/urandom | base64

# Пустые значения специально: compose (${VAR:?}) не запустится, пока их не заполнишь.
# Пароль: openssl rand -base64 24
SEMAPHORE_ADMIN_PASSWORD=
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost
SEMAPHORE_ADMIN=admin
# Ключ шифрования: head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# Внешний порт Semaphore UI (внутренний всегда 3000):
SEMAPHORE_PORT=3000
# Адрес публикации порта. 127.0.0.1 — только через SSH-туннель/reverse proxy.
# 0.0.0.0 открывает UI по HTTP всему интернету (Docker обходит UFW).
SEMAPHORE_BIND=127.0.0.1

# Для scripts/semaphore_bootstrap.py (локальный запуск, в UI не нужен):
#   SEMAPHORE_URL=http://localhost:3000/api SEMAPHORE_TOKEN=xxx SEMAPHORE_PROJECT_ID=1 python3 scripts/semaphore_bootstrap.py
SEMAPHORE_URL=http://localhost:3000/api
SEMAPHORE_TOKEN=
SEMAPHORE_PROJECT_ID=1
