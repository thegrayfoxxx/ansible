# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
#
# Генерация ключа шифрования:
#   head -c32 /dev/urandom | base64

SEMAPHORE_ADMIN_PASSWORD=changeme
SEMAPHORE_ADMIN_NAME=admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost
SEMAPHORE_ADMIN=admin
SEMAPHORE_ACCESS_KEY_ENCRYPTION=CHANGE_ME

# Для scripts/semaphore_bootstrap.py (локальный запуск, в UI не нужен):
#   SEMAPHORE_URL=http://localhost:3000/api SEMAPHORE_TOKEN=xxx SEMAPHORE_PROJECT_ID=1 python3 scripts/semaphore_bootstrap.py
SEMAPHORE_URL=http://localhost:3000/api
SEMAPHORE_TOKEN=
SEMAPHORE_PROJECT_ID=1
