# {{ ansible_managed }}
# Remnawave node agent. Rendered by Ansible — do not edit by hand, re-run the remnawave_node_add template.
services:
  remnanode:
    container_name: remnanode
    hostname: remnanode
    image: {{ remnanode_node_image }}
    network_mode: host
    restart: always
{% if (remnanode_mount_shm | default(true) | bool) or (remnanode_mount_logs | default(true) | bool) or (remnanode_mount_xray | default(false) | bool) %}
    volumes:
{% if remnanode_mount_shm | default(true) | bool %}
      - /dev/shm:/dev/shm:rw
{% endif %}
{% if remnanode_mount_logs | default(true) | bool %}
      - {{ remnanode_log_dir | default('/var/log/remnanode', true) }}:/var/log/remnanode:rw
{% endif %}
{% if remnanode_mount_xray | default(false) | bool %}
      - ./xray-core:/usr/local/bin/xray
{% endif %}
{% endif %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    cap_add:
      - NET_ADMIN
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    environment:
      - NODE_PORT=${NODE_PORT}
      - SECRET_KEY=${SECRET_KEY}
