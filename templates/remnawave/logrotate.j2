# {{ ansible_managed }}
# Remnawave xray logs on the node. Rendered by Ansible — do not edit by hand.
# Change size/keep with remnawave_node_config action=apply.
# NOTE: docker json-file limits cover only container stdout, not these files.
{{ remnanode_log_dir }}/*.log {
    su root root
    size {{ remnanode_log_max_size }}
    rotate {{ remnanode_log_keep | int }}
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
}
